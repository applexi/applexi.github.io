---
import { nav, site } from "../site.config";
import ThemeToggle from "./ThemeToggle.astro";

const current = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);

// The resume is a PDF rather than a page, so open it in its own tab.
const isFile = (href: string) => href.endsWith(".pdf");
---

<header>
  <div class="wrapper bar">
    <a class="brand" href="/">{site.title}</a>
    <nav aria-label="Main">
      {
        nav
          .filter((item) => item.href !== "/")
          .map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              target={isFile(item.href) ? "_blank" : undefined}
              rel={isFile(item.href) ? "noopener" : undefined}
            >
              {item.label}
            </a>
          ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .brand {
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  nav a {
    font-size: 0.9375rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current="page"] {
    color: var(--text);
  }

  @media (max-width: 30rem) {
    nav {
      gap: 0.9rem;
    }
  }
</style>
