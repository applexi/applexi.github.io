---
interface Props {
  date: Date;
}

const { date } = Astro.props;

const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<time datetime={date.toISOString()}>{formatted}</time>

<style>
  time {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
</style>
