---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import SeriesSubscribe from "./SeriesSubscribe.astro";
import TagRow from "./TagRow.astro";
import { getSeries } from "../lib/collections";

interface Props {
  post: CollectionEntry<"writing">;
  showDescription?: boolean;
  /** Stands in for the post's own date, where a row speaks for more than one post. */
  date?: Date;
  /** Off where every row is the same kind of thing, so the label would only repeat. */
  showSeries?: boolean;
}

const {
  post,
  showDescription = true,
  date,
  showSeries = true,
} = Astro.props;
const series = await getSeries(post);
---

<article>
  <div class="heading">
    <div class="heading-text">
      <a class="title" href={`/writing/${post.id}`}>{post.data.title}</a>
      {
        showSeries && series && (
        <span class="series">
          {/* The name opens the contents post, which has no need to link to itself. */}
          {series.part > 0 ? (
            <a href={`/writing/${series.contents.id}`}>{series.name}</a>
          ) : (
            series.name
          )}
          {series.part > 0
            ? ` \u00b7 ${series.part} of ${series.parts.length}`
            : " \u00b7 contents"}
        </span>
        )
      }
    </div>
    {series?.subscribe && <SeriesSubscribe series={series} />}
  </div>
  <FormattedDate date={date ?? post.data.pubDate} />
  {showDescription && <p class="muted">{post.data.description}</p>}
  <TagRow tags={post.data.tags} />
</article>

<style>
  article {
    position: relative;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  /* Wraps to its own line on narrow screens rather than squeezing the title. */
  .heading {
    padding-right: 2.5rem;
  }

  .heading-text {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.1rem 0.5rem;
  }

  .heading :global(.subscribe) {
    position: absolute;
    top: 0.75rem;
    right: 0;
  }

  .title {
    font-weight: 550;
    color: var(--text);
    text-decoration: none;
  }

  .title:hover {
    color: var(--accent);
  }

  .series {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .series a {
    color: inherit;
    text-decoration: none;
  }

  .series a:hover {
    color: var(--accent);
  }

  p {
    margin: 0.35rem 0 0.6rem;
    font-size: 0.9375rem;
  }
</style>
