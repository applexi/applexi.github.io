---
import { render } from "astro:content";
// Styles the math that remark-math/rehype-katex render at build time.
import "katex/dist/katex.min.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CodeCopy from "../../components/CodeCopy.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import SeriesBox from "../../components/SeriesBox.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import SeriesSubscribe from "../../components/SeriesSubscribe.astro";
import TagRow from "../../components/TagRow.astro";
import { getPosts, getSeries } from "../../lib/collections";

export async function getStaticPaths() {
  const posts = await getPosts();

  // /writing/series is the index of every series, and a static route quietly outranks
  // this one, so a post of that name would never be reachable.
  const clash = posts.find((post) => post.id === "series");
  if (clash) {
    throw new Error(
      `"${clash.filePath}" would be published at /writing/series, which belongs to the ` +
        `series index. Rename the file.`,
    );
  }

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
const series = await getSeries(post);
---

<BaseLayout title={title} description={description}>
  <a class="back" href="/writing">&larr; Writing</a>

  <article>
    <header>
      <div class="title-row">
        <h1>{title}</h1>
        {series?.subscribe && <SeriesSubscribe series={series} />}
      </div>
      <p class="meta">
        <FormattedDate date={pubDate} />
        {updatedDate && <span class="muted">· updated <FormattedDate date={updatedDate} /></span>}
      </p>
      <TagRow tags={tags} />
    </header>

    <div class="prose">
      <Content />
    </div>

    {series?.part === 0 && <SeriesBox series={series} />}

    {series && series.part > 0 && <SeriesNav series={series} />}
  </article>

  <CodeCopy />
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    text-decoration: none;
  }

  header {
    position: relative;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .title-row {
    padding-right: 3rem;
  }

  .title-row h1 {
    margin-bottom: 0.75rem;
  }

  .title-row :global(.subscribe) {
    position: absolute;
    top: -0.1rem;
    right: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
  }
</style>
