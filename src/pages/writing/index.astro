---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostLink from "../../components/PostLink.astro";
import { getAllSeries, getListedPosts } from "../../lib/collections";
import { site } from "../../site.config";

const posts = await getListedPosts();
// No pill while there's nothing behind it.
const hasSeries = (await getAllSeries()).length > 0;
---

<BaseLayout title="Writing" description={`Writing by ${site.title}.`}>
  <div class="page-heading">
    <h1>Writing</h1>
    {hasSeries && <a class="tag" href="/writing/series">All series &rarr;</a>}
  </div>

  {
    posts.length === 0 ? (
      <p class="muted">
        No posts yet. Add a Markdown file to <code>src/content/writing/</code>.
      </p>
    ) : (
      posts.map((post) => <PostLink post={post} />)
    )
  }
</BaseLayout>
