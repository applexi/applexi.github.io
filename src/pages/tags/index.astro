---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagGroups, tagCount, type Tag } from "../../lib/tags";
import { site } from "../../site.config";

const { important, normal } = await getTagGroups();

const groups: { heading: string; blurb: string; tags: Tag[] }[] = [
  {
    heading: "Kinds of thing",
    blurb:
      "What something is.",
    tags: important,
  },
  {
    heading: "Topics",
    blurb: "What something is about.",
    tags: normal,
  },
];
---

<BaseLayout title="Tags" description={`Browse work by ${site.title} by tag.`}>
  <h1>Tags</h1>
  {
    important.length === 0 && normal.length === 0 && (
      <p class="muted">
        Nothing is tagged yet. Add a <code>tags</code> list to a project or post.
      </p>
    )
  }

  {
    groups
      .filter((group) => group.tags.length > 0)
      .map((group) => (
        <section>
          <h2>{group.heading}</h2>
          <p class="muted blurb">{group.blurb}</p>
          <ul class="tag-pills">
            {group.tags.map((tag) => (
              <li>
                <a class="tag-pill" href={`/tags/${tag.slug}`}>
                  {tag.label} <span class="muted">{tagCount(tag)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
  }
</BaseLayout>

<style>
  section + section {
    margin-top: 2.5rem;
  }

  h2 {
    margin-bottom: 0.35rem;
  }

  .blurb {
    margin: 0;
    font-size: 0.9375rem;
  }

  .tag-pills {
    margin-top: 1rem;
  }
</style>
